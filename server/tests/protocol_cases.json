[
  {"name": "ping_shape", "steps": [
    {"method": "ping", "expect_ok": true, "expect_keys": ["plugin_version", "active_file", "active_root"]}
  ]},
  {"name": "box_result_shape", "steps": [
    {"method": "new_part", "params": {"name": "proto"}, "expect_ok": true},
    {"method": "create_box", "params": {"center": [0, 0, 0], "size": [10, 10, 10], "combine": "none"},
     "expect_ok": true, "expect_keys": ["shape_id", "bounding_box", "volume", "area"]}
  ]},
  {"name": "unknown_method", "steps": [
    {"method": "no_such_method", "expect_ok": false, "expect_error_code": "UNKNOWN_METHOD"}
  ]},
  {"name": "missing_shape", "steps": [
    {"method": "new_part", "params": {"name": "proto"}, "expect_ok": true},
    {"method": "get_bounding_box", "params": {"shape_id": 424242}, "expect_ok": false, "expect_error_code": "INVALID_INPUT"}
  ]}
]
